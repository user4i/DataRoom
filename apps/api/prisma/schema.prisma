generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  dataRooms    DataRoom[]
  shares       Share[]
  comments     Comment[]
  tagDefs      TagDef[]
  statusDefs   StatusDef[]
  aiSettings   UserAiSettings?
}

model DataRoom {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  folders   Folder[]
  files     File[]
  shares    Share[]
  resourceLinks ResourceLink[]

  @@index([ownerId])
}

model Folder {
  id         String    @id @default(uuid())
  dataRoomId String
  dataRoom   DataRoom  @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Folder[]  @relation("FolderTree")
  name       String
  path       String
  totalSize  BigInt    @default(0)
  itemCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  files      File[]
  shares     Share[]
  comments   Comment[]
  resourceTags ResourceTag[]
  resourceStatus ResourceStatus?
  linksAsLeft  ResourceLink[] @relation("LinkLeftFolder")
  linksAsRight ResourceLink[] @relation("LinkRightFolder")

  @@index([dataRoomId, parentId])
  @@index([path])
  @@index([dataRoomId, name])
}

model File {
  id         String    @id @default(uuid())
  dataRoomId String
  dataRoom   DataRoom  @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name       String
  storageKey String
  size       BigInt
  mimeType   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  shares     Share[]
  versions   FileVersion[]
  comments   Comment[]
  resourceTags ResourceTag[]
  resourceStatus ResourceStatus?
  linksAsLeft  ResourceLink[] @relation("LinkLeftFile")
  linksAsRight ResourceLink[] @relation("LinkRightFile")

  @@index([dataRoomId, folderId])
  @@index([folderId, name])
  @@index([dataRoomId, name])
}

model FileVersion {
  id         String   @id @default(uuid())
  fileId     String
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version    Int
  storageKey String
  size       BigInt
  createdAt  DateTime @default(now())

  @@unique([fileId, version])
  @@index([fileId])
}

enum ResourceType {
  DATA_ROOM
  FOLDER
  FILE
}

enum ShareKind {
  PUBLIC_LINK
  USER
}

enum ShareRole {
  VIEWER
  EDITOR
}

enum AiProvider {
  GEMINI
  OPENAI_COMPATIBLE
}

enum AnalysisKind {
  FILE_SUMMARY
  FOLDER_SUMMARY
  FOLDER_COMPARE
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model UserAiSettings {
  userId       String     @id
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale       String     @default("en")
  provider     AiProvider @default(OPENAI_COMPATIBLE)
  baseUrl      String?
  model        String?
  apiKeyCipher String?
  apiKeyLast4  String?
  updatedAt    DateTime   @updatedAt
}

model Analysis {
  id           String         @id @default(uuid())
  dataRoomId   String
  resourceType ResourceType
  resourceId   String
  kind         AnalysisKind
  status       AnalysisStatus @default(QUEUED)
  html         String?        @db.Text
  payloadJson  Json?
  error        String?
  locale       String         @default("en")
  contentHash  String?
  requestedBy  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([resourceType, resourceId, kind])
  @@index([status, updatedAt])
  @@index([dataRoomId])
}

model Comment {
  id           String       @id @default(uuid())
  dataRoomId   String
  resourceType ResourceType
  resourceId   String
  body         String       @db.Text
  authorId     String
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  fileId       String?
  file         File?        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       Folder?      @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId, createdAt])
  @@index([dataRoomId])
  @@index([authorId])
}

model TagDef {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#64748b")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  assignments ResourceTag[]

  @@unique([userId, name])
  @@index([userId, sortOrder])
}

model ResourceTag {
  id           String       @id @default(uuid())
  tagId        String
  tag          TagDef       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  resourceType ResourceType
  resourceId   String
  fileId       String?
  file         File?        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       Folder?      @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([tagId, resourceType, resourceId])
  @@index([resourceType, resourceId])
}

model StatusDef {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#64748b")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  assignments ResourceStatus[]

  @@unique([userId, name])
  @@index([userId, sortOrder])
}

model ResourceStatus {
  id           String       @id @default(uuid())
  statusId     String
  status       StatusDef    @relation(fields: [statusId], references: [id], onDelete: Cascade)
  resourceType ResourceType
  resourceId   String
  fileId       String?      @unique
  file         File?        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId     String?      @unique
  folder       Folder?      @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([resourceType, resourceId])
  @@index([statusId])
}

model ResourceLink {
  id            String       @id @default(uuid())
  dataRoomId    String
  dataRoom      DataRoom     @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  leftType      ResourceType
  leftId        String
  rightType     ResourceType
  rightId       String
  leftFileId    String?
  leftFile      File?        @relation("LinkLeftFile", fields: [leftFileId], references: [id], onDelete: Cascade)
  leftFolderId  String?
  leftFolder    Folder?      @relation("LinkLeftFolder", fields: [leftFolderId], references: [id], onDelete: Cascade)
  rightFileId   String?
  rightFile     File?        @relation("LinkRightFile", fields: [rightFileId], references: [id], onDelete: Cascade)
  rightFolderId String?
  rightFolder   Folder?      @relation("LinkRightFolder", fields: [rightFolderId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([leftType, leftId, rightType, rightId])
  @@index([leftType, leftId])
  @@index([rightType, rightId])
  @@index([dataRoomId])
}

model Share {
  id           String       @id @default(uuid())
  resourceType ResourceType
  resourceId   String
  kind         ShareKind
  role         ShareRole    @default(VIEWER)
  token        String?      @unique
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedEmail String?
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())
  dataRoomId   String?
  dataRoom     DataRoom?    @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       Folder?      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileId       String?
  file         File?        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
  @@index([userId, revokedAt])
  @@index([invitedEmail, revokedAt])
  @@index([token])
}

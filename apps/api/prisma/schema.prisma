generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  dataRooms    DataRoom[]
  shares       Share[]
  aiSettings   UserAiSettings?
}

model DataRoom {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  folders   Folder[]
  files     File[]
  shares    Share[]

  @@index([ownerId])
}

model Folder {
  id         String    @id @default(uuid())
  dataRoomId String
  dataRoom   DataRoom  @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Folder[]  @relation("FolderTree")
  name       String
  path       String
  totalSize  BigInt    @default(0)
  itemCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  files      File[]
  shares     Share[]

  @@index([dataRoomId, parentId])
  @@index([path])
  @@index([dataRoomId, name])
}

model File {
  id         String    @id @default(uuid())
  dataRoomId String
  dataRoom   DataRoom  @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folderId   String?
  folder     Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name       String
  storageKey String
  size       BigInt
  mimeType   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  shares     Share[]
  versions   FileVersion[]

  @@index([dataRoomId, folderId])
  @@index([folderId, name])
  @@index([dataRoomId, name])
}

model FileVersion {
  id         String   @id @default(uuid())
  fileId     String
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version    Int
  storageKey String
  size       BigInt
  createdAt  DateTime @default(now())

  @@unique([fileId, version])
  @@index([fileId])
}

enum ResourceType {
  DATA_ROOM
  FOLDER
  FILE
}

enum ShareKind {
  PUBLIC_LINK
  USER
}

enum ShareRole {
  VIEWER
  EDITOR
}

enum AiProvider {
  GEMINI
  OPENAI_COMPATIBLE
}

enum AnalysisKind {
  FILE_SUMMARY
  FOLDER_SUMMARY
  FOLDER_COMPARE
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model UserAiSettings {
  userId       String     @id
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale       String     @default("en")
  provider     AiProvider @default(OPENAI_COMPATIBLE)
  baseUrl      String?
  model        String?
  apiKeyCipher String?
  apiKeyLast4  String?
  updatedAt    DateTime   @updatedAt
}

model Analysis {
  id           String         @id @default(uuid())
  dataRoomId   String
  resourceType ResourceType
  resourceId   String
  kind         AnalysisKind
  status       AnalysisStatus @default(QUEUED)
  html         String?        @db.Text
  payloadJson  Json?
  error        String?
  locale       String         @default("en")
  contentHash  String?
  requestedBy  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([resourceType, resourceId, kind])
  @@index([status, updatedAt])
  @@index([dataRoomId])
}

model Share {
  id           String       @id @default(uuid())
  resourceType ResourceType
  resourceId   String
  kind         ShareKind
  role         ShareRole    @default(VIEWER)
  token        String?      @unique
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedEmail String?
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())
  dataRoomId   String?
  dataRoom     DataRoom?    @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       Folder?      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileId       String?
  file         File?        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
  @@index([userId, revokedAt])
  @@index([invitedEmail, revokedAt])
  @@index([token])
}

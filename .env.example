# Copy to apps/api/.env and apps/web/.env.local as noted below.

# --- apps/api/.env ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

DATABASE_URL=postgresql://dataroom:dataroom@localhost:5433/dataroom

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Required when STORAGE_DRIVER=s3 (Cloudflare R2 / S3-compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# Optional. Used to encrypt per-user AI API keys (falls back to JWT_SECRET).
AI_KEY_SECRET=

# --- apps/web/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:3001
